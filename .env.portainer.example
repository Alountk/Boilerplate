# --- CONFIGURACIÓN PARA PORTAINER STACK ---
# Copia estos valores a la sección de "Environment Variables" en tu Stack de Portainer.

# --- PUERTOS (Omitir si vas a usar un Reverse Proxy como Nginx o Cloudflare)
API_PORT=5017
WEB_PORT=3000

# --- BASE DE DATOS (POSTGRESQL EXISTENTE)
# Ej: Server=192.168.1.10;Port=5432;Database=videogamesdb;User Id=user;Password=pass;
CONNECTION_STRING=

# --- JWT (SEGURIDAD)
# Debe ser una cadena de al menos 32-64 caracteres para producción.
JWT_SECRET=
JWT_ISSUER=VideogamesAPI
JWT_AUDIENCE=VideogamesClient
JWT_EXPIRY_MINUTES=60

# --- MINIO (EN PRODUCCIÓN)
# La URL completa, incluir http/https. Ej: https://minio.tuservidor.com
MINIO_ENDPOINT=
MINIO_USER=
MINIO_SECRET=
MINIO_BUCKET=videogames
MINIO_USE_SSL=true

# --- FRONTEND (NEXT.JS)
# ¡CRÍTICO! Esta es la URL que el NAVEGADOR del usuario usará para llegar a la API.
# Si expones por puerto: http://tu-ip-o-dominio:5017/api
# Si usas proxy: https://api.tuservicio.com/api
NEXT_PUBLIC_API_URL=
# Versión visible en UI (si construyes imagen web desde compose local)
NEXT_PUBLIC_APP_VERSION=local-dev

# --- IMÁGENES Y VERSIONADO (RECOMENDADO)
# Fija una versión publicada por CI para despliegues reproducibles.
APP_VERSION=latest
API_IMAGE_REPO=ghcr.io/alountk/vmarket-api
WEB_IMAGE_REPO=ghcr.io/alountk/vmarket-web
