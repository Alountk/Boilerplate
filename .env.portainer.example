# --- CONFIGURACIÓN PARA PORTAINER STACK ---
# Copia estos valores a la sección de "Environment Variables" en tu Stack de Portainer.

# --- PUERTOS (Omitir si vas a usar un Reverse Proxy como Nginx o Cloudflare)
API_PORT=5017
WEB_PORT=3000

# --- BASE DE DATOS (POSTGRESQL EXISTENTE)
# Ej: Server=192.168.1.10;Port=5432;Database=videogamesdb;User Id=user;Password=pass;
CONNECTION_STRING=

# --- JWT (SEGURIDAD)
# Debe ser una cadena de al menos 32-64 caracteres para producción.
JWT_SECRET=
JWT_ISSUER=VideogamesAPI
JWT_AUDIENCE=VideogamesClient
JWT_EXPIRY_MINUTES=60

# --- MINIO (EN PRODUCCIÓN)
# La URL completa, incluir http/https. Ej: https://minio.tuservidor.com
MINIO_ENDPOINT=
MINIO_USER=
MINIO_SECRET=
MINIO_BUCKET=videogames
MINIO_USE_SSL=true

# --- SMTP / EMAIL VERIFICATION
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# --- FRONTEND (NEXT.JS)
# ¡CRÍTICO! Esta es la URL que el NAVEGADOR del usuario usará para llegar a la API.
# Si expones por puerto: http://tu-ip-o-dominio:5017/api
# Si usas proxy: https://api.tuservicio.com/api
# IMPORTANTE: en imágenes web publicadas por CI, NEXT_PUBLIC_* se inyecta en build-time
# desde variables del repositorio de GitHub Actions (NO desde runtime de Arcane/Portainer).
NEXT_PUBLIC_API_URL=
# Base pública para assets frontend compilados (hero/categorías/login),
# por ejemplo: https://s3.tuservidor.com/videogames
NEXT_PUBLIC_IMAGE_BASE_URL=https://s3.tuservidor.com/videogames
# Versión visible en UI (si construyes imagen web desde compose local)
NEXT_PUBLIC_APP_VERSION=local-dev

# --- IMÁGENES Y VERSIONADO (RECOMENDADO)
# Orígenes CORS permitidos para API (coma-separados), por ejemplo:
# https://vmarket.marchan.dev,https://www.vmarket.marchan.dev
CORS_ALLOWED_ORIGINS=

# --- IMÁGENES Y VERSIONADO (RECOMENDADO)
# En Portainer/Arcane/GitOps usa una versión inmutable `main-<runNumber>-<shortSha>`.
# `main-latest` es útil para pulls manuales, pero en despliegues automáticos puede provocar
# un desfase de una release si el stack se actualiza antes de que GHCR publique el nuevo tag.
APP_VERSION=main-<runNumber>-<shortSha>
API_IMAGE_REPO=ghcr.io/alountk/vmarket-api
WEB_IMAGE_REPO=ghcr.io/alountk/vmarket-web
