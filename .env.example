# Example environment file - Copy to .env.local and fill in YOUR values
# ⚠️  NEVER commit .env.local to git repository

# --- FRONTEND CONFIG (PUBLIC - safe to expose)
NEXT_PUBLIC_API_URL=http://localhost:5017/api
NEXT_PUBLIC_RAWG_API_KEY=YOUR_RAWG_API_KEY_HERE
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
NEXT_PUBLIC_APPLE_CLIENT_ID=YOUR_APPLE_CLIENT_ID_HERE
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://localhost

# --- SERVICE PORTS
API_PORT=5017
WEB_PORT=3000

# --- DATABASE (PostgreSQL)
# Format: Server=host;Port=port;Database=dbname;User Id=user;Password=pass;
CONNECTION_STRING=Server=localhost;Port=5432;Database=videogamesdb;User Id=postgres;Password=YOUR_POSTGRES_PASSWORD_HERE

# --- AUTHENTICATION (JWT)
# Generate a strong random string (min 32 chars): openssl rand -base64 32
JWT_SECRET=YOUR_JWT_SECRET_HERE_MIN_32_CHARS
JWT_ISSUER=VideogamesAPI
JWT_AUDIENCE=VideogamesClient
JWT_EXPIRY_MINUTES=60

# --- MINIO / S3 STORAGE
# Local development:
MINIO_ENDPOINT=http://localhost:9000
# Production:
# MINIO_ENDPOINT=https://s3.yourdomain.com
MINIO_USER=minioadmin
MINIO_SECRET=YOUR_MINIO_PASSWORD_HERE
MINIO_BUCKET=videogames
MINIO_USE_SSL=false

# --- SMTP / EMAIL VERIFICATION (Optional but required to actually send emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply@yourdomain.com
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_OR_APP_TOKEN_HERE
SMTP_ENABLE_SSL=true

# --- OAUTH (Optional)
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_SECRET_HERE
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID_HERE

# --- DOCKER IMAGE TAGS (for Portainer)
API_IMAGE_TAG=videogames-api:latest
WEB_IMAGE_TAG=videogames-web:latest
