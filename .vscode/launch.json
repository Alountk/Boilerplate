{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Launch API (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Videogames.API",
            "program": "${workspaceFolder}/Videogames.API/bin/Debug/net10.0/Videogames.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Videogames.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5017"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "justMyCode": true
        },
        {
            "name": "🔗 Attach to running API",
            "type": "coreclr",
            "request": "attach",
            "processName": "Videogames.API",
            "justMyCode": true,
            "sourceFileMap": {
                "/app": "${workspaceFolder}/Videogames.API"
            }
        }
    ]
}
